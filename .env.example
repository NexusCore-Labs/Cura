# Gemini (server-side only: used by api/*.js, never exposed to the browser)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional per-endpoint model overrides; GEMINI_MODEL is the single-model alias.
GEMINI_MODEL_READ=gemini-2.5-flash
GEMINI_MODEL_EXPLAIN=gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Server-side payload limit for /api/read-prescription (bytes)
MAX_IMAGE_BYTES=4000000

# Client-side (safe values only, Vite exposes anything starting with VITE_)
VITE_APP_NAME=Cura