# Gemini (server-side only: used by api/*.js, never exposed to the browser)
GEMINI_MODEL_READ=gemini-3.8-flash
GEMINI_MODEL_EXPLAIN=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite

# Server limits
MAX_IMAGE_BYTES=4000000
REQUEST_TIMEOUT_MS=30000
RATE_LIMIT_PER_MINUTE=10

# Allowed website origin for the API (use your deployed URL in production)
ALLOWED_ORIGIN=http://localhost:3000

# Client-side (safe values only, Vite exposes anything starting with VITE_)
VITE_APP_NAME=Cura
VITE_DEMO_MODE=false